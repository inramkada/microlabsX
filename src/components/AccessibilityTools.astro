<div class="tools-switch" id="tools-switch">
  <button class="tools-trigger" aria-label="Accessibility & tools" data-i18n-aria-label="tools.trigger" type="button">
    <svg class="tools-icon" viewBox="0 0 24 24" aria-hidden="true">
      <path fill="currentColor" d="M12 5C6.5 5 2.1 8.4 1 12c1.1 3.6 5.5 7 11 7s9.9-3.4 11-7c-1.1-3.6-5.5-7-11-7zm0 11a4 4 0 1 1 0-8a4 4 0 0 1 0 8zm0-6a2 2 0 1 0 0 4a2 2 0 0 0 0-4z" />
    </svg>
  </button>

  <div class="tools-rail" id="tools-rail" aria-label="Accessibility and tools" data-i18n-aria-label="tools.rail">
    <button class="tool-pill" data-action="font-up" data-label="Increase text" type="button">A+</button>
    <button class="tool-pill" data-action="font-down" data-label="Decrease text" type="button">A-</button>
    <button class="tool-pill" data-action="readable" data-label="Regulatory font" type="button">FONT</button>
    <button class="tool-pill" data-action="contrast" data-label="High contrast" type="button">HC</button>
    <button class="tool-pill" data-action="lightbg" data-label="Light reader" type="button">LIGHT</button>
    <button class="tool-pill tool-audio" data-action="audio" data-label="Play / Pause audio" type="button">
      <svg class="icon-play" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M8 5v14l11-7z" /></svg>
      <svg class="icon-pause" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6 5h4v14H6zm8 0h4v14h-4z" /></svg>
    </button>
    <button class="tool-pill tool-icon" data-action="pdf" data-label="Download PDF" type="button" aria-label="Download PDF" title="Download PDF">
      <svg class="dl-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path fill="currentColor" d="M5 20h14v-2H5v2zm7-18v10.17l3.59-3.58L17 10l-5 5-5-5 1.41-1.41L11 12.17V2h1z" />
      </svg>
    </button>
    <button class="tool-pill" data-action="reset" data-label="Reset" type="button">RESET</button>
  </div>
</div>
