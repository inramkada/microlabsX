    <circle cx="23" cy="7" r="1.7" fill="#FFDE00"/><circle cx="27" cy="12" r="1.7" fill="#FFDE00"/>
    <circle cx="27" cy="18" r="1.7" fill="#FFDE00"/><circle cx="22" cy="22" r="1.7" fill="#FFDE00"/>
