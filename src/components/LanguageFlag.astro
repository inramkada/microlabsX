---
interface Props {
  lang: string;
}
const { lang } = Astro.props;

const flagSequences: Record<string, { flags: string[]; interval: number }> = {
  en: {
    flags: ["gb", "us"],
    interval: 1050,
  },
  es: {
    // 20 sovereign states where Spanish is an official national language.
    flags: [
      "es", "mx", "co", "ar", "pe", "ve",
      "cl", "ec", "gt", "cu", "bo", "do",
      "hn", "py", "sv", "ni", "cr", "pa",
      "uy", "gq",
    ],
    interval: 540,
  },
  ar: {
    // 22 Arab League member states. Preferred markets appear first.
    flags: [
      "sa", "ae", "kw", "qa", "ps", "ma",
      "bh", "om", "ye", "iq", "jo", "lb",
      "sy", "eg", "ly", "tn", "dz", "mr",
      "sd", "so", "dj", "km",
    ],
    interval: 540,
  },
};

const sequence = flagSequences[lang];
---

{sequence && (
  <span
    class="lang-flag-sequence"
    data-flag-sequence
    data-flags={sequence.flags.join(",")}
    data-interval={String(sequence.interval)}
    aria-hidden="true"
  >
    <span class="lang-flag-seq-frame is-current" data-flag-slot="0"></span>
    <span class="lang-flag-seq-frame" data-flag-slot="1"></span>
  </span>
)}

{lang === "ca" && (
  <svg class="lang-flag-svg" viewBox="0 0 60 40" aria-hidden="true" focusable="false">
    <rect width="60" height="40" fill="#FCDD09"/>
    <path d="M0 6h60M0 16h60M0 26h60M0 36h60" stroke="#DA121A" stroke-width="5"/>
  </svg>
)}

{lang === "eu" && (
  <svg class="lang-flag-svg" viewBox="0 0 60 40" aria-hidden="true" focusable="false">
    <rect width="60" height="40" fill="#D52B1E"/>
    <path d="M0 0 60 40M60 0 0 40" stroke="#009B48" stroke-width="7"/>
    <path d="M30 0v40M0 20h60" stroke="#fff" stroke-width="5"/>
  </svg>
)}

{lang === "zh" && (
  <svg class="lang-flag-svg" viewBox="0 0 60 40" aria-hidden="true" focusable="false">
    <rect width="60" height="40" fill="#DE2910"/>
