---
import AccessibilityTools from "./AccessibilityTools.astro";
import LanguageSelector from "./LanguageSelector.astro";

interface Props {
  showAccessibility?: boolean;
  showHome?: boolean;
  showPrimaryNav?: boolean;
}

const {
  showAccessibility = false,
  showHome = true,
  showPrimaryNav = true,
} = Astro.props;
---

<header id="mx-header">
  <div class="topbar">
    <a class="brand" href="/" aria-label="MICROLABSX home">
      MICROLABS<span class="brand-x">X</span>
    </a>

    <nav aria-label="Primary navigation">
      {showHome && (
        <a class="lang-trigger home-trigger" href="/" aria-label="Home" title="Home">
          <svg class="globe home-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              d="M4 10.5 12 4l8 6.5V20h-5.5v-5.5h-5V20H4v-9.5Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      )}

      <LanguageSelector />
      {showAccessibility && <AccessibilityTools />}

      {showPrimaryNav && (
        <a
          class="navlink nav-contact"
          href="mailto:info@microretailx.com"
          data-i18n="nav.contact"
        >
          CONTACT
        </a>
      )}
    </nav>
  </div>
</header>
